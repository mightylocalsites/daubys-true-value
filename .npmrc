# A standalone client site installs the @mightylocalsites framework packages from
# GitHub Packages. Set NODE_AUTH_TOKEN in the build env (Cloudflare Pages →
# Settings → Environment variables, and in CI) to a token with `read:packages`.
@mightylocalsites:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
