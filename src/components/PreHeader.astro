---
import { telHref } from "@mightylocalsites/astro-data";
import { SocialLinks, StatusBadge } from "@mightylocalsites/ui";
import type { SocialLink, StoreStatus } from "@mightylocalsites/astro-data";
import { siteTagline } from "../data/content";

interface Props {
  address?: string | null;
  addressHref?: string | null;
  status?: StoreStatus | null;
  phone?: string | null;
  email?: string | null;
  social?: SocialLink[];
}

const {
  address = null,
  addressHref = null,
  status = null,
  phone = null,
  email = null,
  social = [],
} = Astro.props;

const showStatus = Boolean(status);
const hasLeadDetails = Boolean(address) || social.length > 0;
const hasRight = Boolean(email) || Boolean(phone);
const show = Boolean(siteTagline) || showStatus || hasLeadDetails || hasRight;
---

{
  show && (
    <div class="ml-preheader">
      <div class="ml-preheader__start">
        <p class="ml-preheader__tagline">{siteTagline}</p>
        {showStatus && <StatusBadge status={status!} variant="dot" />}
      </div>

      {
        hasLeadDetails && (
          <div class="ml-preheader__group ml-preheader__group--lead">
            <div class="ml-preheader__lead-cluster">
              {
                address && (
                  <span class="ml-preheader__item">
                    <a
                      href={addressHref ?? "#"}
                      target={addressHref ? "_blank" : undefined}
                      rel={addressHref ? "noopener noreferrer" : undefined}
                    >
                      <i class="fas fa-map-marker-alt fa-lg ml-preheader__hl" aria-hidden="true" />
                      <span class="ml-preheader__text">{address}</span>
                    </a>
                  </span>
                )
              }
            </div>

            {
              social.length > 0 && (
                <span class="ml-preheader__social">
                  <SocialLinks links={social} />
                </span>
              )
            }
          </div>
        )
      }

      {
        hasRight && (
          <div class="ml-preheader__group ml-preheader__group--contact">
            {
              email && (
                <span class="ml-preheader__item">
                  <a href={`mailto:${email}`}>
                    <i class="fas fa-envelope" aria-hidden="true" />
                    <span class="ml-preheader__text">{email}</span>
                  </a>
                </span>
              )
            }
            {
              phone && (
                <span class="ml-preheader__item">
                  <a href={telHref(phone)}>
                    <i class="fas fa-phone-alt" aria-hidden="true" />
                    <span class="ml-preheader__text">{phone}</span>
                  </a>
                </span>
              )
            }
          </div>
        )
      }
    </div>
  )
}

<style>
  .ml-preheader {
    display: none;
  }

  @media (min-width: 768px) {
    .ml-preheader {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 1.5rem;
      background: var(--ml-preheader-bg, var(--ml-color-primary, #3772b3));
      color: var(--ml-preheader-text, #ffffff);
      font-size: 0.875rem;
      line-height: 1.25rem;
      padding-inline: 4rem;
      position: relative;
      z-index: 10;
    }
  }

  .ml-preheader__tagline {
    margin: 0;
    flex: 0 1 auto;
    max-width: 28rem;
    text-align: left;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.01em;
    padding-block: 0.85rem;
  }

  .ml-preheader__start {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    flex: 0 1 auto;
    min-width: 0;
  }

  .ml-preheader__start .ml-preheader__tagline {
    padding-block: 0.85rem;
  }

  .ml-preheader__group--lead {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    min-width: 0;
  }

  .ml-preheader__lead-cluster {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .ml-preheader__social {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--ml-preheader-text, #ffffff);
  }

  .ml-preheader__group--contact {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
    margin-left: auto;
  }

  .ml-preheader__item {
    display: inline-block;
    padding-block: 0.75rem;
  }

  .ml-preheader a {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .ml-preheader a:hover .ml-preheader__text {
    text-decoration: none;
  }

  .ml-preheader i {
    margin-right: 0.4rem;
  }

  .ml-preheader__hl {
    color: var(--ml-preheader-text, #ffffff);
  }
</style>
