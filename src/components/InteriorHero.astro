---
interface Props {
  image: string;
  alt: string;
  title: string;
  location?: string;
  cta?: { label: string; href: string };
}

const { image, alt, title, location, cta } = Astro.props;
---

<section class="interior-hero">
  <img
    class="interior-hero__img"
    src={image}
    alt={alt}
    fetchpriority="high"
    decoding="async"
  />
  <div class="interior-hero__overlay">
    <h1 class="interior-hero__title">{title}</h1>
    {location && <p class="interior-hero__loc">{location}</p>}
    {cta && <a class="ml-btn interior-hero__cta" href={cta.href}>{cta.label}</a>}
  </div>
</section>
