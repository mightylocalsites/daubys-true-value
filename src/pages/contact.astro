---
/**
 * Contact — quick links, map, and contact form.
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import { ContactForm } from "@mightylocalsites/ui";
import FaviconLinks from "../components/FaviconLinks.astro";
import { getSiteChrome, getSiteConfig } from "../lib/site-chrome";
import { fullAddress, mapsHref, telHref } from "@mightylocalsites/astro-data";
import { images, locationsHref, withShopifyLogo } from "../data/images";
import { DEFAULT_OG_IMAGE, pageCanonical } from "../lib/seo";
import "../styles/site.css";

const { apiBaseUrl, host } = getSiteConfig();
const chrome = withShopifyLogo(await getSiteChrome(Astro.response));
const { owner } = chrome.site;
const primary = chrome.site.locations[0] ?? null;
const turnstileSiteKey = chrome.site.site?.settings?.turnstile?.site_key ?? null;
const canonical = pageCanonical(Astro.url, Astro.site);

const address = primary ? fullAddress(primary) : "1522 10th St, Tell City, IN 47586";
const directionsHref = mapsHref(address);
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
const phone = primary?.phone ?? "(812) 547-2566";
const email = primary?.email ?? "daubyhwde@gmail.com";
---

<SiteLayout
  {...chrome}
  logo={images.logo}
  title={`Contact ${owner.name}`}
  description={`Get in touch with ${owner.name} in Tell City, IN — call, email, or send us a message.`}
  canonical={canonical}
  ogImage={DEFAULT_OG_IMAGE}
  locationsHref={locationsHref}
>
  <FaviconLinks slot="head" />

  <div class="page-flow">
    <header class="page-hero">
      <p class="page-hero__eyebrow">Get in touch</p>
      <h1>Contact Us</h1>
      <p>
        Have a question, need a quote, or want help finding the right supplies?
        Send a message and our team will get back to you.
      </p>
    </header>

    <ul class="contact__quick">
      <li>
        <a href={directionsHref} target="_blank" rel="noopener">
          <i class="fa-solid fa-location-dot" aria-hidden="true"></i> {address}
        </a>
      </li>
      <li>
        <a href={telHref(phone)}>
          <i class="fa-solid fa-phone" aria-hidden="true"></i> {phone}
        </a>
      </li>
      <li>
        <a href={`mailto:${email}`}>
          <i class="fa-solid fa-envelope" aria-hidden="true"></i> {email}
        </a>
      </li>
    </ul>

    <div class="contact">
      <div class="contact__map">
        <iframe
          title={`Map to ${owner.name}`}
          src={mapEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <div class="contact__panel">
        <ContactForm apiBaseUrl={apiBaseUrl} host={host} turnstileSiteKey={turnstileSiteKey} />
      </div>
    </div>
  </div>
</SiteLayout>
