---
/**
 * /services — Stoppel-style hero + icon-led service grid.
 * Copy from https://daubyshardware.com/pages/services
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import FaviconLinks from "../components/FaviconLinks.astro";
import { getSiteChrome } from "../lib/site-chrome";
import { telHref } from "@mightylocalsites/astro-data";
import { imageAlt, images, locationsHref, withShopifyLogo } from "../data/images";
import { services, servicesIntro } from "../data/content";
import { DEFAULT_OG_IMAGE, pageCanonical } from "../lib/seo";
import "../styles/site.css";

const chrome = withShopifyLogo(await getSiteChrome(Astro.response));
const { owner } = chrome.site;
const primary = chrome.site.locations[0] ?? null;
const canonical = pageCanonical(Astro.url, Astro.site);
const locationLabel = primary?.locality && primary?.administrative_area
  ? `${primary.locality}, ${primary.administrative_area}`
  : "Tell City, IN";
const phone = primary?.phone ?? "(812) 547-2566";
---

<SiteLayout
  {...chrome}
  logo={images.logo}
  title={`Services | ${owner.name}`}
  description={`Services at ${owner.name} in Tell City, IN — quotes and estimates, key cutting, lock rekeying, paint matching, and special ordering.`}
  canonical={canonical}
  ogImage={DEFAULT_OG_IMAGE}
  locationsHref={locationsHref}
>
  <FaviconLinks slot="head" />

  <section class="svc-hero">
    <img
      class="svc-hero__img"
      src={images.svcHero}
      alt={imageAlt.svcHero}
      fetchpriority="high"
      decoding="async"
    />
    <div class="svc-hero__overlay">
      <h1 class="svc-hero__title">Services</h1>
      <p class="svc-hero__loc">{locationLabel}</p>
      <a class="ml-btn svc-hero__cta" href="/contact">Contact Us</a>
    </div>
  </section>

  <div class="page-flow">
    <p class="page-intro">{servicesIntro}</p>

    <section class="block">
      <ul class="svc-grid svc-grid--page">
        {
          services.map((s) => (
            <li class="svc-grid__item">
              <span class="svc-grid__icon" aria-hidden="true">
                <i class={s.icon}></i>
              </span>
              <div>
                <h2>{s.title}</h2>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cta-band">
      <div>
        <h2>Questions?</h2>
        <p>Call or stop by — we're glad to help.</p>
      </div>
      <div class="cta-band__actions">
        <a class="btn btn--primary" href="/contact">Contact Us</a>
        <a class="btn btn--outline" href={telHref(phone)}>
          <i class="fa-solid fa-phone" aria-hidden="true"></i> {phone}
        </a>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  :global(html) {
    overflow-x: clip;
  }

  .svc-hero {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin: -20px -50vw 48px;
    overflow: hidden;
    background: var(--ml-color-surface-alt, #f3f4f6);
  }

  .svc-hero__img {
    display: block;
    width: 100%;
    height: clamp(240px, 40vw, 460px);
    object-fit: cover;
  }

  .svc-hero__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    padding: 24px;
    color: #fff;
    background: rgba(0, 0, 0, 0.4);
  }

  .svc-hero__title {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    color: #fff;
  }

  .svc-hero__loc {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 500;
    color: #fff;
  }

  .svc-hero__cta {
    margin-top: 8px;
    color: #fff !important;
  }

  .page-flow {
    max-width: 1080px;
    margin: 0 auto 48px;
  }

  .page-intro {
    margin: 0 0 32px;
    text-align: center;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ml-color-muted, #6b7280);
  }
</style>
