---
/**
 * Events — branded override with site chrome and Stoppel-style hero.
 */
import SiteLayout from "../../layouts/SiteLayout.astro";
import { EventList } from "@mightylocalsites/ui";
import FaviconLinks from "../../components/FaviconLinks.astro";
import InteriorHero from "../../components/InteriorHero.astro";
import { getSiteChrome, getSiteContentSafe, applyCache } from "../../lib/site-chrome";
import { imageAlt, images, locationsHref, withShopifyLogo } from "../../data/images";
import { DEFAULT_OG_IMAGE, pageCanonical } from "../../lib/seo";
import "../../styles/site.css";

const [chrome, content] = await Promise.all([
  getSiteChrome(Astro.response),
  getSiteContentSafe(Astro.response, ["events"]),
]);
withShopifyLogo(chrome);
applyCache(Astro.response, content.cacheControl);

const { owner } = chrome.site;
const primary = chrome.site.locations[0] ?? null;
const events = content.data.events ?? [];
const canonical = pageCanonical(Astro.url, Astro.site);
const locationLabel = primary?.locality && primary?.administrative_area
  ? `${primary.locality}, ${primary.administrative_area}`
  : "Tell City, IN";
---

<SiteLayout
  {...chrome}
  logo={images.logo}
  title={`Events | ${owner.name}`}
  description={`Community events and in-store happenings at ${owner.name} in Tell City, IN.`}
  canonical={canonical}
  ogImage={DEFAULT_OG_IMAGE}
  locationsHref={locationsHref}
>
  <FaviconLinks slot="head" />

  <InteriorHero
    image={images.heroDepartments}
    alt={imageAlt.heroDepartments}
    title="Events"
    location={locationLabel}
  />

  <div class="page-flow page-flow--flush">
    <header class="page-hero">
      <p class="page-hero__eyebrow">Community</p>
      <h1>Upcoming Events</h1>
      <p>What's happening at {owner.name}.</p>
    </header>

    <EventList
      events={events}
      hrefBase="/events"
      emptyMessage="No upcoming events right now — check back soon or follow us for the latest store happenings."
    />
  </div>
</SiteLayout>

<style>
  :global(html) {
    overflow-x: clip;
  }
</style>
