---
/**
 * /about-us — Stoppel-style hero + icon-led intro (no invented history).
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import FaviconLinks from "../components/FaviconLinks.astro";
import { getSiteChrome } from "../lib/site-chrome";
import { imageAlt, images, locationsHref, withShopifyLogo } from "../data/images";
import { aboutIntro, siteTagline } from "../data/content";
import { DEFAULT_OG_IMAGE, pageCanonical } from "../lib/seo";
import "../styles/site.css";

const chrome = withShopifyLogo(await getSiteChrome(Astro.response));
const { owner } = chrome.site;
const primary = chrome.site.locations[0] ?? null;
const canonical = pageCanonical(Astro.url, Astro.site);
const locationLabel = primary?.locality && primary?.administrative_area
  ? `${primary.locality}, ${primary.administrative_area}`
  : "Tell City, IN";
---

<SiteLayout
  {...chrome}
  logo={images.logo}
  title={`About Us | ${owner.name}`}
  description={`About ${owner.name} in Tell City, IN — your local True Value hardware store for tools, paint, electrical, plumbing, and helpful in-store services.`}
  canonical={canonical}
  ogImage={DEFAULT_OG_IMAGE}
  locationsHref={locationsHref}
>
  <FaviconLinks slot="head" />

  <section class="page-hero-banner">
    <img
      class="page-hero-banner__img"
      src={images.aboutHero}
      alt={imageAlt.aboutHero}
      fetchpriority="high"
      decoding="async"
    />
    <div class="page-hero-banner__overlay">
      <h1 class="page-hero-banner__title">About Dauby's True Value Hardware</h1>
      <p class="page-hero-banner__loc">{locationLabel}</p>
      <a class="ml-btn page-hero-banner__cta" href="/contact">Contact Us</a>
    </div>
  </section>

  <div class="page-flow">
    <section class="about-card">
      <span class="about-card__icon" aria-hidden="true">
        <i class="fa-solid fa-store"></i>
      </span>
      <div>
        <h2>About Us</h2>
        <p>{aboutIntro}</p>
        <p>{siteTagline}</p>
        <p>
          Visit us at 1522 10th St in Tell City for paint and supplies, electrical,
          plumbing, tools, sporting goods, key cutting, lock rekeying, paint matching,
          and special ordering — with a team ready to help you find what you need.
        </p>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  :global(html) {
    overflow-x: clip;
  }

  .page-hero-banner {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin: -20px -50vw 48px;
    overflow: hidden;
    background: var(--ml-color-surface-alt, #f3f4f6);
  }

  .page-hero-banner__img {
    display: block;
    width: 100%;
    height: clamp(240px, 40vw, 460px);
    object-fit: cover;
  }

  .page-hero-banner__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    padding: 24px;
    color: #fff;
    background: rgba(0, 0, 0, 0.4);
  }

  .page-hero-banner__title {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    color: #fff;
  }

  .page-hero-banner__loc {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 500;
    color: #fff;
  }

  .page-hero-banner__cta {
    margin-top: 8px;
    color: #fff !important;
  }

  .page-flow {
    max-width: 1080px;
    margin: 0 auto 48px;
  }

  .about-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px 28px;
    align-items: start;
    padding: 36px 32px;
    background: var(--ml-color-surface, #fff);
    border: 1px solid var(--ml-color-border, #e5e7eb);
    border-radius: var(--ml-radius, 6px);
  }

  .about-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: var(--bv-red-soft, #fdf2f4);
    color: var(--bv-red-dark, #a00c24);
    font-size: 1.35rem;
    border-radius: var(--ml-radius, 6px);
  }

  .about-card h2 {
    margin: 0 0 12px;
    font-size: 1.75rem;
    font-weight: 700;
    padding-bottom: 8px;
    border-bottom: 3px solid var(--ml-color-primary, #a00c24);
  }

  .about-card p {
    margin: 0 0 16px;
    font-size: 1rem;
    line-height: 1.7;
    color: #374151;
  }

  .about-card p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .about-card {
      grid-template-columns: 1fr;
    }
  }
</style>
