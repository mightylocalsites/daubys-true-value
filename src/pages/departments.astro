---
/**
 * /departments — Stoppel-style hero + icon-led department grid.
 * Copy from https://daubyshardware.com/pages/departments
 */
import SiteLayout from "../layouts/SiteLayout.astro";
import FaviconLinks from "../components/FaviconLinks.astro";
import { getSiteChrome } from "../lib/site-chrome";
import { telHref } from "@mightylocalsites/astro-data";
import { imageAlt, images, locationsHref, withShopifyLogo } from "../data/images";
import { departments, departmentsIntro } from "../data/content";
import { DEFAULT_OG_IMAGE, pageCanonical } from "../lib/seo";
import "../styles/site.css";

const chrome = withShopifyLogo(await getSiteChrome(Astro.response));
const { owner } = chrome.site;
const primary = chrome.site.locations[0] ?? null;
const canonical = pageCanonical(Astro.url, Astro.site);
const locationLabel = primary?.locality && primary?.administrative_area
  ? `${primary.locality}, ${primary.administrative_area}`
  : "Tell City, IN";
const phone = primary?.phone ?? "(812) 547-2566";
---

<SiteLayout
  {...chrome}
  logo={images.logo}
  title={`Departments | ${owner.name}`}
  description={`Explore departments at ${owner.name} in Tell City, IN — hardware, electrical, tools, paint, plumbing, sporting goods, and seasonal supplies.`}
  canonical={canonical}
  ogImage={DEFAULT_OG_IMAGE}
  locationsHref={locationsHref}
>
  <FaviconLinks slot="head" />

  <section class="dept-hero">
    <img
      class="dept-hero__img"
      src={images.deptHero}
      alt={imageAlt.deptHero}
      fetchpriority="high"
      decoding="async"
    />
    <div class="dept-hero__overlay">
      <h1 class="dept-hero__title">Departments</h1>
      <p class="dept-hero__loc">{locationLabel}</p>
      <a class="ml-btn dept-hero__cta" href="/contact">Contact Us</a>
    </div>
  </section>

  <div class="page-flow">
    <p class="page-intro">{departmentsIntro}</p>

    <section class="block">
      <ul class="dept-grid dept-grid--page">
        {
          departments.map((d) => (
            <li class="dept-grid__item">
              <span class="dept-grid__icon" aria-hidden="true">
                <i class={d.icon}></i>
              </span>
              <div>
                <h2>{d.title}</h2>
                <p>{d.body}</p>
                {
                  d.bullets && d.bullets.length > 0 && (
                    <ul class="dept-bullets">
                      {d.bullets.map((item) => <li>{item}</li>)}
                    </ul>
                  )
                }
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cta-band">
      <div>
        <h2>Need something specific?</h2>
        <p>Ask about special orders — our team can help track down hard-to-find items.</p>
      </div>
      <div class="cta-band__actions">
        <a class="btn btn--primary" href="/contact">Contact Us</a>
        <a class="btn btn--outline" href={telHref(phone)}>
          <i class="fa-solid fa-phone" aria-hidden="true"></i> {phone}
        </a>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  :global(html) {
    overflow-x: clip;
  }

  .dept-hero {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin: -20px -50vw 48px;
    overflow: hidden;
    background: var(--ml-color-surface-alt, #f3f4f6);
  }

  .dept-hero__img {
    display: block;
    width: 100%;
    height: clamp(240px, 40vw, 460px);
    object-fit: cover;
  }

  .dept-hero__cta {
    margin-top: 8px;
    color: #fff !important;
  }
</style>
